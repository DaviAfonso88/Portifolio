{
  "name": "@davidev/infrastructure",
  "version": "1.0.0",
  "private": true,
  "description": "Adaptadores de Infraestrutura do DaviDev — Drizzle ORM e Neon HTTP",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --experimental-strip-types ./src/db/seed.ts"
  },
  "dependencies": {
    "@davidev/application": "workspace:*",
    "@davidev/domain": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  }
}
