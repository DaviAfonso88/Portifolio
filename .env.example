# Segredo para proteger o disparo do Cron Job diário de manutenção (P-003)
CRON_SECRET="seu-token-secreto-para-o-cron-job-da-vercel"

# ------------------------------------------------------------------------------
# 3. Administrador do Sistema (Login inicial)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="daviafonso5894@gmail.com"
ADMIN_PASSWORD="Daviafonso144."

# ------------------------------------------------------------------------------
# 4. Anti-bot & Captcha (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Obtenha no dashboard da Cloudflare:
